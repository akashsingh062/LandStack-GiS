# ==============================================================================
# LandStack — Comprehensive .gitignore
# ==============================================================================

# 1. Environment & Secret Variables (CRITICAL — NEVER COMMIT)
.env
.env*.local
.env.development
.env.test
.env.production
.env.vault
*.env

# 2. Package Dependencies
node_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
hackathon-prepration.txt
# 3. Next.js & Build Outputs
.next/
out/
build/
dist/
.swc/

# 4. TypeScript & Tool Caches
*.tsbuildinfo
next-env.d.ts.bak
.cache/
.parcel-cache/
.turbo/
.eslintcache

# 5. Heavy GIS Datasets & Spatial Shapefiles (> 100MB, keep local)
data/
data/raw/
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.qpj
*.qmd
*.shp.xml
*.tif
*.tiff
*.gpkg
*.geotiff
*.las
*.laz
*.kml
*.kmz

# 6. Database & Docker Volumes
postgres_data/
supabase/.temp/
*.sqlite
*.sqlite3
*.db
*.dump
*.backup

# 7. QGIS & Desktop GIS Workspace Files
gis/*.qgz
gis/*.qgs
gis/*.qgz~
gis/*.qgs~
*.qgz
*.qgs

# 8. Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# 9. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# 10. IDE & Editor Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 11. AI Scratchpads, Transcripts & Reference Dumps
gptchatdetail/
gptchatdetail*
.tempmediaStorage/
.system_generated/
scratch/

DESIGN_SYSTEM.png
CLAUDE.md
AGENTS.md
context.md
ProblemStatement.md